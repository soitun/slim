---
import SiteHeader from './site-header.astro';
import SiteFooter from './site-footer.astro';
import Layout from '../layouts/layout.astro';

const props = Astro.props;
const { title, description, heading, intro, updated } = props;
---

<Layout title={title} description={description}>
  <SiteHeader />
  <main class="max-w-(--max-width) mx-auto px-(--padding-x) py-16 min-h-[70vh]">
    <h1 class="text-2xl font-bold text-text mb-2">{heading}</h1>
    <p class="text-text-secondary text-[15px] leading-relaxed">{intro}</p>
    <p class="text-text-tertiary text-xs mt-3 mb-10">Last updated: {updated}</p>
    <div class="legal-body">
      <slot />
    </div>
  </main>
  <SiteFooter />
</Layout>

